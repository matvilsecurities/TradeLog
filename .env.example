VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Shown in the app UI (About/version info). Optional.
VITE_APP_VERSION=1.0.0

# NinjaTrader / Tradovate OAuth
# Client ID is safe to expose to the browser; the client secret MUST stay in Netlify env vars, never here.
VITE_NT_CLIENT_ID=your_ninjatrader_oauth_client_id
VITE_NT_ENVIRONMENT=live

# Netlify server-side secrets (set these in Netlify's dashboard env vars, not in this file)
# Required by netlify/functions/* — the Tradovate/NinjaTrader OAuth callback will fail without them.
# NT_CLIENT_ID=your_ninjatrader_oauth_client_id
# NT_CLIENT_SECRET=your_ninjatrader_oauth_client_secret
# NT_OAUTH_REDIRECT_URI=https://YOUR-SITE.netlify.app/.netlify/functions/tradovate-oauth-callback
# NT_ENVIRONMENT=live
